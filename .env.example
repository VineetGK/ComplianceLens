# Copy to .env and fill in. Never commit .env.

# --- LLM provider: nvidia | anthropic | mock ---------------------------------
LLM_PROVIDER=nvidia

# NVIDIA API Catalog (free tier): https://build.nvidia.com -> Get API Key
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_EXTRACTION=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_MAPPING=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_COVERAGE=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
# guided_json (nvext) | json_schema (response_format) | tool (function calling)
NVIDIA_STRUCTURED_MODE=guided_json

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACTION=claude-haiku-5-5
ANTHROPIC_MODEL_MAPPING=claude-sonnet-5-5
ANTHROPIC_MODEL_COVERAGE=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# low | medium | high
ANTHROPIC_EFFORT=low

# Rate limiting / retries / cache
LLM_RPM=30
LLM_MAX_RETRIES=5
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=30.0
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# --- Embeddings: nvidia | local | mock ----------------------------------------
EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Database -----------------------------------------------------------------
POSTGRES_USER=compliancelens
POSTGRES_PASSWORD=compliancelens
POSTGRES_DB=compliancelens
DATABASE_URL=postgresql+psycopg://compliancelens:compliancelens@localhost:5432/compliancelens

# --- Tracing (Arize Phoenix, local) -------------------------------------------
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=compliancelens

# --- App ----------------------------------------------------------------------
LOG_LEVEL=INFO
